# 复制为 .env 后填写。
# 支持：OpenAI 官方 / 各类 OpenAI Compatible 网关 / 局域网双服务（聊天 + Embedding）。

# API Key：云端填真实密钥；局域网不校验时可填 local
OPENAI_API_KEY=local

# 聊天服务 Base URL（可写根地址，程序会自动补 /v1）
# 官方可留空；局域网示例：
# OPENAI_BASE_URL=http://192.168.13.23:8842
OPENAI_BASE_URL=

# 聊天模型名（OpenAI Compatible 填服务端 model id）
# 示例：Qwen3.5-27B-Q8_0.gguf 或 openai:gpt-4o-mini
MODEL_NAME=openai:gpt-4o-mini

# Embedding 服务（可与聊天分离；留空则回退到 OPENAI_BASE_URL）
# 示例：http://192.168.13.23:9997
EMBEDDING_BASE_URL=

# Embedding 模型名
# 示例：bge-m3 或 text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small

# ---------- 局域网双服务完整示例（取消注释并复制到 .env）----------
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://192.168.13.23:8842/v1
# MODEL_NAME=Qwen3.5-27B-Q8_0.gguf
# EMBEDDING_BASE_URL=http://192.168.13.23:9997/v1
# EMBEDDING_MODEL=bge-m3

# 可选：LangSmith 观测（M08）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=langchain-simon-notes
