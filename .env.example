# 复制为 .env 后填写。兼容 OpenAI 官方与各类 OpenAI-Compatible 网关。

# 必填：API Key
OPENAI_API_KEY=sk-your-key-here

# 可选：兼容网关 Base URL（留空则走官方 OpenAI）
# 例如：https://api.openai.com/v1 或国内中转地址
OPENAI_BASE_URL=

# 聊天模型名（传给 init_chat_model / ChatOpenAI）
MODEL_NAME=openai:gpt-4o-mini

# Embedding 模型（RAG 模块使用）
EMBEDDING_MODEL=text-embedding-3-small

# 可选：LangSmith 观测（M08 文档会说明）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=langchain-simon-notes
